#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    local executable=/usr/libexec/portal-local-proxy/portal-local-proxy
    local configuration=/etc/portal-local-proxy/config.json
    "$executable" -config "$configuration" -check >/dev/null || return 1
    procd_open_instance
    procd_set_param command "$executable" -config "$configuration"
    procd_set_param user nobody
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$configuration"
    procd_close_instance
}

reload_service() {
    /usr/libexec/portal-local-proxy/portal-local-proxy -config /etc/portal-local-proxy/config.json -check >/dev/null || return 1
    stop
    start
}
